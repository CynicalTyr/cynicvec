# Names only. This library does not read secrets at runtime.
# Copy to .env if your dual-write worker later uses named paths.
# Never commit .env.
#
# Index cache path (your worker, not this kernel):
# CYNICVEC_INDEX_PATH=/tmp/cynicvec-demo.tvim
#
# Embedding width must match the SQL / sqlite-vec column:
# CYNICVEC_DIM=2048
#
# Optional backend switch so you can skip the ANN:
# MEMORY_VECTOR_BACKEND=cynicvec
# MEMORY_VECTOR_BACKEND=sqlite_vec
# SCARAB_VECTOR_BACKEND=cynicvec
# SCARAB_VECTOR_BACKEND=sqlite_vec
#
# Optional demo dir for *your* worker, not this kernel:
# AGENT_HOME=/tmp/cynicvec-demo
